{
  "name": "cambium",
  "version": "0.1.0",
  "exports": "./main.ts",
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns"],
    "strict": true,
    "skipLibCheck": true
  },
  "imports": {
    "react": "npm:react@^18.3.1",
    "react/jsx-runtime": "npm:react@^18.3.1/jsx-runtime",
    "react-dom/client": "npm:react-dom@^18.3.1/client",
    "@types/react": "npm:@types/react@^18.3.12",
    "@types/react-dom": "npm:@types/react-dom@^18.3.1",
    "@tiptap/core": "npm:@tiptap/core@^2.11.0",
    "@tiptap/react": "npm:@tiptap/react@^2.11.0",
    "@tiptap/pm": "npm:@tiptap/pm@^2.11.0",
    "@tiptap/starter-kit": "npm:@tiptap/starter-kit@^2.11.0",
    "@tiptap/extension-link": "npm:@tiptap/extension-link@^2.11.0",
    "@tiptap/extension-code-block": "npm:@tiptap/extension-code-block@^2.11.0",
    "tiptap-markdown": "npm:tiptap-markdown@^0.8.10",
    "zustand": "npm:zustand@^4.5.5",
    "yaml": "npm:yaml@^2.5.1",
    "abcjs": "npm:abcjs@^6.4.4",
    "lowlight": "npm:lowlight@^3.3.0",
    "highlight.js": "npm:highlight.js@^11.11.0",
    "mermaid": "npm:mermaid@^11.4.1",
    "graphology": "npm:graphology@^0.25.4",
    "sigma": "npm:sigma@^3.0.1",
    "graphology-layout-forceatlas2": "npm:graphology-layout-forceatlas2@^0.10.1",
    "vite": "npm:vite@^5.4.11",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/assert": "jsr:@std/assert@^1.0.7"
  },
  "tasks": {
    "install": "deno install",
    "dev:be": "deno run -A --watch main.ts",
    "dev:fe": "deno run -A npm:vite",
    "dev": "deno run -A dev.ts",
    "build": "deno run -A npm:vite build",
    "desktop": "deno task build && deno desktop -A --include dist main.ts",
    "desktop:hmr": "deno desktop -A --include dist --hmr main.ts",
    "package": "deno task build && deno desktop -A --include dist main.ts",
    "test": "deno test -A tests/",
    "check": "deno check main.ts backend/ adapters/ src-core/ web/global.d.ts web/main.tsx",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "desktop": {
    "app": {
      "name": "Cambium",
      "identifier": "app.cambium.desktop"
    },
    "backend": "webview",
    "output": {
      "macos": "./dist-desktop/Cambium.app",
      "windows": "./dist-desktop/cambium",
      "linux": "./dist-desktop/cambium"
    }
  },
  "fmt": {
    "exclude": ["dist", "dist-desktop", "node_modules", "web/.vite"]
  },
  "lint": {
    "exclude": ["dist", "dist-desktop", "node_modules", "web/.vite"],
    "rules": {
      "exclude": [
        "no-window",
        "no-window-prefix",
        "jsx-button-has-type",
        "no-explicit-any"
      ]
    }
  }
}
